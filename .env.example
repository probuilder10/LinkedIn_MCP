# LinkedIn auth — use a session cookie (safer than password). Get `li_at` from your browser's cookies.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Fallback email/password (only used if cookies are empty). Challenge-auth will fail headlessly if triggered.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# OpenAI (used only for message personalization and ICP scoring — optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage
LINKEDIN_MCP_DB=./data/linkedin_mcp.sqlite

# Safety limits (per 24h)
MAX_CONNECTION_REQUESTS_PER_DAY=80
MAX_MESSAGES_PER_DAY=120
MAX_PROFILE_VIEWS_PER_DAY=200
MIN_ACTION_DELAY_SECONDS=8
MAX_ACTION_DELAY_SECONDS=25

# Outbound webhook for signals/campaign events (Slack/Discord/custom, optional)
NOTIFY_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
